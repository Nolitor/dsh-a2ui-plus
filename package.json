{
  "name": "@nolit/dsh-a2ui-plus",
  "version": "0.0.1-rc.3",
  "description": "Generative UI for DeepSeek Harness: A2UI 1.0 surfaces inline or in the sidebar, with AG-UI state deltas and a bidirectional function channel.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "a2ui",
    "generative-ui",
    "agent-ui"
  ],
  "license": "MIT",
  "author": "nolit",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ko.md",
    "docs/**/*.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0 || >=0.2.3-alpha.2 <0.3.0",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/check-dead-wires.mjs --quiet && node tools/run-tests.mjs",
    "verify": "node tools/verify-bundle.mjs",
    "render": "node tools/render-check.mjs",
    "all": "npm run typecheck && npm run build && npm test && npm run verify && npm run render && npm run verify:fresh-home",
    "verify:fresh-home": "node tools/verify-fresh-home.mjs",
    "test:e2e": "node --test tests/e2e/",
    "check:wires": "node scripts/check-dead-wires.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "fast-json-patch": "^3.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.2",
    "ws": "^8.23.0"
  }
}